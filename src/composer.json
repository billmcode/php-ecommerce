{
    "name": "sandbox/php-ecommerce",
    "description": "Simple PHP ecommerce REST API",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "predis/predis": "^2.0",
        "php-amqplib/php-amqplib": "^3.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
